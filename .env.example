GITHUB_TOKEN=
BASE_URL=https://api.github.com


DBHOST=
DATABASE_NAME=
DBUSER=
DBPASSWORD=
PGPORT=5432

# Ingestion window and batching
BATCH_SIZE=100
LOOKBACK_DAYS=30
MAX_PAGES=50

PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
# Host port for the pgAdmin UI (8081; 8080 may be used by other projects)
PGADMIN_PORT=8081

# Airflow (docker-compose)
# Host uid: `echo AIRFLOW_UID=$(id -u)` - keeps files written by containers
# owned by you instead of root.
AIRFLOW_UID=50000
# Local-only encryption key for Airflow: `docker run --rm apache/airflow:3.3.2 \
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
FERNET_KEY=
# Airflow web UI admin account (created by airflow-init)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Superset (docker-compose.superset.yml)
# Generate with: `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`
SUPERSET_SECRET_KEY=
# Web UI admin account (created by superset-init)
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
# Host port for the Superset UI (8081 is pgAdmin, 8090 is Airflow)
SUPERSET_PORT=8088
# Password of the `superset` role owning the metadata database
SUPERSET_DB_PASSWORD=superset
# Read-only role used by Superset to query the analytics warehouse
SUPERSET_RO_USER=superset_ro
SUPERSET_RO_PASSWORD=superset_ro
# Where the worker reaches the webserver (inside the compose network) and
# where the reader of an e-mail reaches it (from the host).
SUPERSET_BASEURL=http://superset:8088/
SUPERSET_BASEURL_USER_FRIENDLY=http://localhost:8088/
# E-mail delivery for scheduled reports and alerts (optional).
# Without SMTP_HOST the reports are generated but cannot be delivered.
# The compose overlay ships a mail catcher on `superset-mail:1025`.
SUPERSET_SMTP_FROM=superset@superset.local
SUPERSET_SMTP_HOST=
SUPERSET_SMTP_PORT=25
SUPERSET_SMTP_USERNAME=
SUPERSET_SMTP_PASSWORD=
SUPERSET_SMTP_USE_TLS=false
SUPERSET_SMTP_USE_SSL=false
# Host port of the mail catcher's web UI
SUPERSET_MAIL_PORT=8025
